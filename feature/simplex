from scipy.optimize import linprog

# Коэффициенты целевой функции (отрицательные, так как linprog минимизирует)
c = [-5, -4]

# Коэффициенты левой части ограничений (A_ub * x <= b_ub)
A = [
    [1, 1],  # x1 + x2 <= 5
    [2, 1],  # 2x1 + x2 <= 8
    [1, 2]   # x1 + 2x2 <= 8
]

# Коэффициенты правой части ограничений
b = [5, 8, 8]

# Границы для переменных (x1 >= 0, x2 >= 0)
x_bounds = (0, None)
y_bounds = (0, None)

# Решение симплекс-методом
res = linprog(c, A_ub=A, b_ub=b, bounds=[x_bounds, y_bounds], method='highs')

# Вывод результата
if res.success:
    print("Решение найдено:")
    print(f"x1 = {res.x[0]:.2f}")
    print(f"x2 = {res.x[1]:.2f}")
    print(f"Максимальное значение z = {-res.fun:.2f}")
else:
    print("Решение не найдено.")
